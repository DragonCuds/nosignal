# Copy to .env, replace every placeholder, then chmod 600 .env.
# TCP port the server listens on (on BIND_HOST, default 127.0.0.1).
PORT=3050
# Comma-separated browser origins allowed to use authenticated API routes in production.
TRUSTED_ORIGINS=https://tel.example.com
# The SQLite database is stored at DATA_DIR/tel.db alongside uploaded media.
# Back up this whole directory as one unit. Keep it outside the release directory.
DATA_DIR=/var/lib/tel-messenger
# Shared chat attachment + encrypted-media quota per user (MiB, default 2048).
#USER_QUOTA_MB=2048
# Service-wide cap for those files (MiB, default 20480); set above existing stored usage.
#SERVER_STORAGE_QUOTA_MB=20480
# Keep this much disk free before accepting another upload (MiB, default 512).
#MIN_FREE_STORAGE_MB=512
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# Separate 32-byte channel wrapping key. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Keep old entries while rotating; select the new entry with CHANNEL_ACTIVE_KEY_ID.
CHANNEL_KEYRING=key1:REPLACE_WITH_32_RANDOM_BYTES_AS_BASE64URL
CHANNEL_ACTIVE_KEY_ID=key1
# Passkeys are scoped to this relying-party domain. It must equal the trusted
# origin hostname or be one of its parent domains. Do not include a scheme/port.
WEBAUTHN_RP_ID=tel.example.com
# Display name shown in the passkey prompt.
WEBAUTHN_RP_NAME=NoSignal
# Own HTTPS (no nginx needed): off (default, plain HTTP behind your own proxy), auto (local CA +
# self-issued certificate under DATA_DIR/tls, CA served at /ca.crt), or files (your own certificate).
# For a public DNS name, use a publicly trusted certificate. In auto mode, keep ca.key offline
# after initial issuance and renew the leaf during a maintenance window (see DEPLOYMENT.md).
TLS_MODE=off
# auto mode: comma-separated names/IPs for the certificate (default localhost,127.0.0.1,::1).
#TLS_HOSTS=tel.local,192.168.1.10
# files mode: PEM paths (re-read daily, so a renewed certificate needs no restart).
#TLS_CERT_FILE=/etc/tel-messenger/fullchain.pem
#TLS_KEY_FILE=/etc/tel-messenger/privkey.pem
# Listen address. Default 127.0.0.1; set 0.0.0.0 when TLS_MODE is auto/files and clients connect directly.
#BIND_HOST=127.0.0.1
# Open signup: 1/true lets anyone create an account with just an ID and password
# (POST /api/register). DEFAULT OFF: when off, only the admin CLI and invite links create accounts.
# Invite links work either way. Turn it on only if you want a public service.
#OPEN_REGISTRATION=0
# Telegram sticker import (optional, off without a token). Create a bot at @BotFather and set the token here.
#TELEGRAM_BOT_TOKEN=
# Bot API base, e.g. a mirror or reverse proxy where api.telegram.org is blocked (default https://api.telegram.org).
#TELEGRAM_API_BASE=https://api.telegram.org
# Plain http: is refused unless BOTH this is 1 AND the base is a literal loopback address (127.x.x.x or [::1], e.g. a local Bot API server).
# Names such as localhost and any non-loopback http: base always disable the import.
#TELEGRAM_API_ALLOW_LOCAL_HTTP=
